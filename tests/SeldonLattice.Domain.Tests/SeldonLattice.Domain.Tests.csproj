<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SeldonLattice.Domain\SeldonLattice.Domain.csproj" />
    <ProjectReference Include="..\..\src\SeldonLattice.Infrastructure\SeldonLattice.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Required for `dotnet test`: without it the SDK never emits the test-platform
         entries into deps.json, so testhost.dll and Microsoft.TestPlatform.*.dll are
         copied to the output but are invisible to the host (FileNotFoundException on
         Microsoft.TestPlatform.CoreUtilities). -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>

</Project>
